APP_NAME="Pusat Sekolah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pusat.smkibupakusari.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pusat
DB_USERNAME=pusat
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true jika diakses lewat HTTPS (produksi). Untuk uji lewat http://IP biarkan false.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# IP reverse proxy (NPMplus), pisahkan dengan koma. Isi "*" hanya jika yakin.
TRUSTED_PROXIES=192.168.10.10

# Masa berlaku token akses SSO (detik)
PUSAT_TOKEN_TTL=3600

MAIL_MAILER=log
